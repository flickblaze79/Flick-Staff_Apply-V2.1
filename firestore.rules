rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Global Helpers ---
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    
    // Only verify email_verified for standard user actions, not necessarily for Owner
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    function isOwner() {
      return isSignedIn() && (
        request.auth.uid == 'NtQwPhiWQpRRnq2klOAKnSWoQKi1' ||
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'flickblaze7@gmail.com' ||
          request.auth.token.email.lower() == 'nxtawais95@gmail.com'
        ))
      );
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection - Hardened
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner() || (isSignedIn() && request.auth.uid == userId);
      
      match /application_settings/cooldown {
        allow read: if isSignedIn() && (isOwner() || request.auth.uid == userId);
        allow write: if isOwner();
      }
    }

    // Applications Collection - Hardened
    match /applications/{appId} {
      allow read: if isSignedIn();
      allow create: if isVerified();
      allow update: if isAdmin() || isOwner();
      allow delete: if isOwner();
    }

    // Reports Collection
    match /reports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isVerified();
      allow update: if isAdmin() || isOwner() || (resource != null && request.auth.uid == resource.data.authorUid);
      allow delete: if isAdmin() || isOwner() || (resource != null && request.auth.uid == resource.data.authorUid);
    }

    // Notifications Collection
    match /notifications/{notifId} {
      allow read, write: if isSignedIn();
    }

    // Audit Logs Collection
    match /audit_logs/{logId} {
      allow read: if isAdmin() || isOwner();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Settings Collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Roles Collection
    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isOwner();
    }

    // Tasks Collection
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isOwner();
    }

    // Custom Panels Collection
    match /custom_panels/{panelId} {
      allow read: if isSignedIn();
      allow write: if isOwner();
    }
    
    // Diagnostic Test Collection
    match /test/{docId} {
      allow read, write: if false;
    }
  }
}

